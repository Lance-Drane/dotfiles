# "man git-config" | https://git-scm.com/docs/git-config
# also see https://blog.gitbutler.com/how-git-core-devs-configure-git for rationale of some of these
[alias]
	pushf = push --force-with-lease --force-if-includes
[branch]
	sort = -committerdate
[column]
	ui = auto
[commit]
	verbose = true
[core]
	pager = delta
[delta]
	hyperlinks = true
	hyperlinks-file-link-format = "lazygit-edit://{path}:{line}"
	features = theme
	line-numbers = true
	navigate = true  # use n and N to move between diff sections
	side-by-side = true
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
	submodule = log
	tool = nvimdiff
[difftool]
	prompt = false
[fetch]
	all = true
	prune = true
	pruneTags = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[help]
	autocorrect = prompt
[interactive]
	diffFilter = delta --color-only
[include]
	path = ~/.config/git/themes/theme.ini
[init]
	defaultBranch = main
[merge]
	conflictstyle = zdiff3
	tool = nvimdiff
[mergetool]
	keepBackup = false
	prompt = false
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	default = simple
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[rerere]
	autoupdate = true
	enabled = true
[tag]
	sort = -version:refname
[url "https://github.com/"]
	insteadOf = ssh://git@github.com
[user]
	email = Lance-Drane@users.noreply.github.com
	name = Lance-Drane
