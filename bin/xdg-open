#!/bin/sh

set -eu

# wrapper script for xdg-open, which is both used by external applications and also assumes a desktop session
# make sure this script appears in $PATH before the actual xdg-open

uri="$1"

termexec() {
	# don't open the application in a new terminal IF we are already in a terminal
	if [ -t 0 ]; then
		exec "$1" "$uri"
	else
		exec "$TERMINAL" -e "$1" "$uri"
	fi
}

# xdg-open by default only handles http(s) schemes, and not very well
# by default, this script handles schemes as files, some schemes such as git:// are ignored
scheme="${uri%%:*}"

if [ -n "$scheme" ] && [ "$scheme" != "$uri" ]; then
	# check that we have a scheme
	case $scheme in
	http | https)
		# TODO check for '.onion' at the end of the URI path
		exec "$BROWSER" "$uri"
		;;
	file)
		# fall-through
		;;
	mailto)
		# this may or may not be the browser
		exec "$MAILAPP" "$uri"
		;;
	about)
		exec "$BROWSER" "$uri"
		;;
	gopher)
		termexec lynx
		;;
	ssh)
		termexec ssh
		;;
	steam)
		exec steam "$uri"
		;;
	chrome)
		exec chromium "$uri"
		;;
	firefox)
		exec firefox "$uri"
		;;
	brave)
		exec brave-browser "$uri"
		;;
	vscode)
		# there are certain cases where the URI should be replaced, i.e. https://github.com/VSCodium/vscodium/issues/401#issuecomment-631502370
		if command -v codium >/dev/null; then exec codium "$uri"; fi
		exec code "$uri"
		;;
	vscodium)
		exec codium "$uri"
		;;
	geo)
		# highly incomplete implementation, does not handle any CRS other than WGS-84 (which SHOULD always be used...) or uncertanity
		# https://datatracker.ietf.org/doc/html/rfc5870
		path="${uri#*:}"
		latlong="${path%%;*}"
		latlong="${latlong%%\?*}"
		lat="${latlong%%,*}"
		long="${latlong%,*}"
		long="${long#*,}" # in case of altitude parameter

		# TODO extract zoom from URI and default to this if it exists
		zoom='13'

		# 'layers' query param can be discovered from OSM's interface, just use default here
		exec "$BROWSER" "https://www.openstreetmap.org/?mlat=${lat}&mlon=${long}&zoom=${zoom}&layers="
		;;
	telnet)
		exec telnet "$uri"
		;;
	*)
		# try default xdg-open application
		exec /usr/bin/xdg-open "$uri"
		;;

	esac
fi

mime=$(file --brief --dereference --mime-type -- "$uri")
case $mime in
application/pdf)
	exec zathura "$uri"
	;;
image/svg+xml)
	#exec inkscape "$uri"
	exec /usr/bin/xdg-open "$uri"
	;;
image/*)
	# probably feh
	exec /usr/bin/xdg-open "$uri"
	;;
audio/* | video/*)
	termexec mpv
	;;
text/* | application/* | inode/x-empty)
	termexec "$EDITOR"
	;;
esac

# fallback to primary xdg-open binary
exec /usr/bin/xdg-open "$uri"
