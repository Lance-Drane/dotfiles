#!/bin/sh

# handles "R,G,B", "R,G,B,X", "R G B", "R G B X", "R, G, B", and "R, G, B, X" style arguments. "X" and anything past it is ignored if present.

set -eu

parse_args() {
	if [ $# -ge 3 ]; then
		red="${1%,}"
		green="${2%,}"
		blue="${3%,}"
	elif [ $# -eq 1 ]; then
		red="${1%%,*}"
		green="${1#"${red}",}"
		green="${green%%,*}"
		blue="${1#"${red}","${green}",}"
		blue="${blue%%,*}"
	else
		echo "usage: $0 <RED>(,)<GREEN>(,)<BLUE>" >&2
		exit 1
	fi
}

# TODO figure out how to mix stdin and args
if [ ! -t 0 ] && {
	[ $# -eq 0 ] || [ "$1" = '-' ]
}; then
	read -r input <&0
	# shellcheck disable=SC2046,SC2086,SC2116  # (deliberate word splitting)
	parse_args $(echo $input)
else
	parse_args "$@"
fi

printf '#%02x%02x%02x\n' "$red" "$green" "$blue"
