#!/bin/sh

set -eu

if [ $# -eq 1 ]; then
	red="${1%%,*}"
	green="${1#"${red}",}"
	green="${green%%,*}"
	blue="${1#"${red}","${green}",}"
	blue="${blue%%,*}"
elif [ $# -ge 3 ]; then
	red="${1%,}"
	green="${2%,}"
	blue="${3%,}"
else
	echo "usage: $0 <RED>(,)<GREEN>(,)<BLUE>" >&2
	exit 1
fi
printf '#%02x%02x%02x\n' "$red" "$green" "$blue"
