#!/bin/sh

# Usage:
# `$0`: Ask for recording type via dmenu
# `$0 screencast`: Record both audio and screen
# `$0 video`: Record only screen
# `$0 audio`: Record only audio
# `$0 webcam`: Record audio and screen, and start webcam
# `$0 kill`: Kill existing recording
#
# If there is already a running instance, user will be prompted to end it.

iconfile="${XDG_RUNTIME_DIR}/recordingicon"
pidfile="${XDG_RUNTIME_DIR}/recordingpid"

getdim() { xrandr | grep -oP '(?<=current ).*(?=,)' | tr -d ' '; }

updateicon() {
	echo "$1" >"$iconfile"
	#pkill -RTMIN+9 "${STATUSBAR:-dwmblocks}"
}

killrecording() {
	recpid="$(cat "$pidfile")"
	kill -15 "$recpid"
	rm -f "$pidfile"
	updateicon ""
	#pkill -RTMIN+9 "${STATUSBAR:-dwmblocks}"
}

screencast() {
	ffmpeg -y \
		-f x11grab \
		-framerate 30 \
		-s "$(getdim)" \
		-i "$DISPLAY" \
		-r 24 \
		-use_wallclock_as_timestamps 1 \
		-f alsa -thread_queue_size 1024 -i default \
		-c:v h264 \
		-crf 0 -preset ultrafast -c:a aac \
		"$HOME/Videos/screencast-$(date '+%y%m%d-%H%M-%S').mp4" &
	echo $! >"$pidfile"
	# updateicon "⏺️🎙️"
	updateicon " "
}

video() {
	ffmpeg \
		-f x11grab \
		-framerate 30 \
		-s "$(getdim)" \
		-i "$DISPLAY" \
		-c:v libx264 -qp 0 -r 30 \
		"$HOME/Videos/video-$(date '+%y%m%d-%H%M-%S').mkv" &
	echo $! >"$pidfile"
	#updateicon "⏺️"
	updateicon " "
}

webcamhidef() {
	ffmpeg \
		-f v4l2 \
		-i /dev/video0 \
		-video_size 1920x1080 \
		"$HOME/Videos/webcam-$(date '+%y%m%d-%H%M-%S').mkv" &
	echo $! >"$pidfile"
	# updateicon "🎥"
	updateicon "󰄄 "
}

webcam() {
	ffmpeg \
		-f v4l2 \
		-i /dev/video0 \
		-video_size 640x480 \
		"$HOME/Videos/webcam-$(date '+%y%m%d-%H%M-%S').mkv" &
	echo $! >"$pidfile"
	# updateicon "🎥"
	updateicon "󰄄 "
}

audio() {
	ffmpeg \
		-f alsa -i default \
		-c:a flac \
		"$HOME/Music/audio-$(date '+%y%m%d-%H%M-%S').flac" &
	echo $! >"$pidfile"
	# updateicon "🎙️"
	updateicon ""
}

askrecording() {
	choice=$(printf "screencast\\nvideo\\nvideo selected\\naudio\\nwebcam\\nwebcam (hi-def)" | rofi -dmenu -i -p "Select recording style:")
	case "$choice" in
	screencast) screencast ;;
	audio) audio ;;
	video) video ;;
	*selected) videoselected ;;
	webcam) webcam ;;
	"webcam (hi-def)") webcamhidef ;;
	esac
}

asktoend() {
	response=$(printf "No\\nYes" | rofi -dmenu -i -p "Recording still active. End recording?") &&
		[ "$response" = "Yes" ] && killrecording
}

videoselected() {
	slop -f "%x %y %w %h" >/tmp/sloprecord
	read -r X Y W H </tmp/sloprecord
	rm /tmp/sloprecord

	ffmpeg \
		-f x11grab \
		-framerate 30 \
		-video_size "$W"x"$H" \
		-i :0.0+"$X,$Y" \
		-c:v libx264 -qp 0 -r 30 \
		"$HOME/Videos/box-$(date '+%y%m%d-%H%M-%S').mkv" &
	echo $! >"$pidfile"
	# updateicon "⏺️"
	updateicon " "
}

case "$1" in
screencast) screencast ;;
audio) audio ;;
video) video ;;
*selected) videoselected ;;
kill) killrecording ;;
*) ([ -f "$pidfile" ] && asktoend && exit) || askrecording ;;
esac
