#!/bin/sh

# 🔇🔊🔉🔈

set -e

icon='󰝟'

vol=$(wpctl get-volume @DEFAULT_SINK@)
# shellcheck disable=SC2086  # deliberate split
set -- $vol

wpctl_arg_count="$#" # may end with '[MUTED]'
vol="$2"

IFS='.'
# shellcheck disable=SC2086  # deliberate split
set -- $vol
vol=$(printf "%.0f" "$1$2") || vol=''

if [ "$wpctl_arg_count" -eq 2 ] && [ -n "$vol" ]; then
	# shellcheck disable=SC2194  # deliberate
	case 1 in
	$((vol >= 70))) icon="󰕾" ;;
	$((vol >= 30))) icon="󰖀" ;;
	*) icon="󰕿" ;;
	esac
fi

echo "$icon $vol%"
